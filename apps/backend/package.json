{
  "name": "example-auth-backend",
  "version": "1.0.0",
  "description": "Backend for Example Auth application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "psql -h localhost -U postgres -d reno_db -f database/ddl/01_schema.sql",
    "db:seed": "psql -h localhost -U postgres -d reno_db -f database/dml/02_seeds.sql",
    "db:reset": "npm run db:create && npm run db:seed"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "pg": "^8.18.0",
    "pg-promise": "^12.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "express",
    "auth",
    "api"
  ],
  "author": "",
  "license": "MIT"
}
